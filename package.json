{
  "name": "vs_ui_utils",
  "version": "0.0.1",
  "description": "Set of utilities functions we need for developing web app.",
  "repository": "https://github.com/dthevenin/UI_Util.git",
  "author": "<david@thevenin.jp>",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist build",
    "prepublish": "npm run clean && npm run build",
    "tsc": "tsc -p src/tsconfig.json",
    "make-bundle": "rollup --config",
    "build": "npm run clean; npm run tsc; npm run make-bundle; rimraf build",
    "test": "nyc mocha --recursive 'test/**/*.spec.ts'",
    "typecheck:test": "tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@istanbuljs/esm-loader-hook": "^0.3.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "happy-dom": "^21.0.3",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vs_utils": "../VS_utils"
  },
  "type": "module",
  "types": "./dist/vs_ui_utils.d.js",
  "exports": {
    ".": {
      "import": "./dist/vs_ui_utils.es.js",
      "require": "./dist/vs_ui_utils.amd.js",
      "types": "./dist/vs_ui_utils.d.js"
    }
  },
  "engines": {
    "node": ">=15.0.0"
  }
}
